# =============================================================================
# Go-Store — Environment Variable Reference
# =============================================================================
# Copy this file:   cp .env.example .env
# Then fill in all values marked *** REQUIRED ***.
# Variables marked [default: X] are optional — the app uses that value when
# the variable is absent or empty.
# NEVER commit .env to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------

# Port the HTTP server listens on.
# [default: 8080]
SERVER_PORT=8080

# Runtime environment. Controls Gin mode and log verbosity.
# Allowed values: development | production
# In production mode Gin runs in ReleaseMode (no debug output).
# [default: development]
APP_ENV=development


# -----------------------------------------------------------------------------
# DATABASE
# PostgreSQL 14+ is the supported database. MySQL config is not yet compatible
# with the current PostgreSQL migrations and query syntax.
# All DB_* variables are assembled into a DSN inside config.DatabaseConfig.DSN()
# -----------------------------------------------------------------------------

# Database driver.
# PostgreSQL is the supported database.
# [default: postgres]
DB_DRIVER=postgres

# Hostname or IP of the database server.
# When running via Docker Compose use the service name, e.g. "postgres".
# [default: localhost]
DB_HOST=localhost

# Port the database listens on.
# PostgreSQL default: 5432
# [default: 5432]
DB_PORT=5432

# Name of the database / schema to connect to.
# [default: gostore]
DB_DATABASE=gostore

# Database login username.
# [default: postgres]
DB_USERNAME=postgres

# *** REQUIRED ***
# Database password. The app prints a warning on startup when this is empty,
# but does not exit — suitable for local dev with passwordless setups.
DB_PASSWORD=

# TLS/SSL mode for the database connection.
# PostgreSQL values: disable | require | verify-ca | verify-full
# [default: disable]
DB_SSL_MODE=disable


# -----------------------------------------------------------------------------
# AUTHENTICATION — JWT
#
# How it works:
#   1. At login a 16-byte cryptographically-random salt is generated.
#   2. signing_key = SHA-256( JWT_SECRET_KEY + salt )
#   3. The JWT is signed with that derived key using HMAC-SHA256.
#   4. Both the token AND the salt are returned to the client.
#   5. Every subsequent request must send:
#        Authorization: Bearer <token>
#        X-Salt: <salt>
#
# Tokens expire after 24 hours.
# -----------------------------------------------------------------------------

# *** REQUIRED ***
# Base secret used to derive per-token HMAC signing keys.
# Generate a secure value:
#   openssl rand -hex 32
# Minimum length: 32 bytes (startup validation enforces this). Rotate periodically.
JWT_SECRET_KEY=


# -----------------------------------------------------------------------------
# CLOUD STORAGE
#
# Use "local" for no-billing development, or explicitly select "s3" or "gcs".
# Cloud providers require your own credentials and billing setup.
#
# Uploaded files use a per-owner SHA-256 namespace with a unique physical-upload suffix.
# S3/GCS buckets must deny public reads; API downloads enforce authorization.
# -----------------------------------------------------------------------------

# Storage backend: local | s3 | gcs
# [default: local]
STORAGE_PROVIDER=local

# Local storage directory (created automatically).
# [default: ./data/files]
LOCAL_STORAGE_ROOT=./data/files

# Enforced per-user quota, including concurrent in-flight upload reservations. Default: 5 GiB.
STORAGE_QUOTA_BYTES=5368709120

# Maximum actual file bytes (multipart framing has a separate 1 MiB allowance). Default: 50 MiB.
# Accepted range: 1 byte through 1 GiB.
MAX_UPLOAD_BYTES=52428800

# Exact allowed browser origins, comma-separated; wildcard is rejected.
# Configure the production frontend origin explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# LOCAL AI INGESTION (optional; no hosted AI APIs or API keys)
# Default mode leaves AI_SERVICE_URL blank; semantic retrieval returns a clear 503.
# AI Compose mode: set AI_SHARED_SECRET below, then run:
#   AI_SERVICE_URL=http://ai-api:8000 docker compose --profile ai up --build
# Generate AI_SHARED_SECRET with: openssl rand -hex 32
# Ollama downloads the open embedding model once into a local volume.
# -----------------------------------------------------------------------------

# Go-to-AI internal HTTP URL. Keep blank when AI is disabled.
# Set to http://ai-api:8000 for the Compose AI profile; for direct local Go runs use
# http://127.0.0.1:8000. Only local/private origins are accepted.
AI_SERVICE_URL=

# *** REQUIRED to enable the Compose AI profile ***
# Shared HMAC secret; never expose to browsers or commit a populated .env file.
AI_SHARED_SECRET=

# Local open-source embedding model managed by Ollama.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Separate local generation model used for document summaries (not embeddings).
OLLAMA_SUMMARY_MODEL=llama3.2:3b
# Docker uses the internal ollama service name; direct host runs can use http://127.0.0.1:11434.
# AI service validation rejects public hosted inference endpoints.
OLLAMA_BASE_URL=http://ollama:11434

# Bounded document, OCR, chunk, retry, and retrieval settings.
AI_MAX_DOCUMENT_BYTES=52428800
AI_MAX_PDF_PAGES=250
AI_MAX_OCR_PAGES=40
AI_MAX_EXTRACTED_CHARS=2500000
AI_CHUNK_SIZE=1200
AI_CHUNK_OVERLAP=150
AI_MAX_ATTEMPTS=5
AI_POLL_SECONDS=2


# --- AWS S3 ------------------------------------------------------------------
# Used when STORAGE_PROVIDER=s3

# AWS region where the S3 bucket is located.
# [default: us-east-1]
AWS_REGION=us-east-1

# *** REQUIRED when STORAGE_PROVIDER=s3 ***
# Name of the S3 bucket. The bucket must already exist.
AWS_BUCKET_NAME=

# *** REQUIRED when STORAGE_PROVIDER=s3 ***
# IAM access key ID for a user/role with these minimum permissions:
#   s3:PutObject  s3:DeleteObject  s3:GetObject
AWS_ACCESS_KEY_ID=

# *** REQUIRED when STORAGE_PROVIDER=s3 ***
# IAM secret access key that pairs with AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=


# --- Google Cloud Storage ----------------------------------------------------
# Used when STORAGE_PROVIDER=gcs

# *** REQUIRED when STORAGE_PROVIDER=gcs ***
# GCP project ID that owns the bucket.
GOOGLE_CLOUD_PROJECT_ID=

# *** REQUIRED when STORAGE_PROVIDER=gcs ***
# Name of the GCS bucket. The bucket must already exist.
GOOGLE_CLOUD_BUCKET_NAME=

# *** REQUIRED when STORAGE_PROVIDER=gcs ***
# Absolute or relative path to the GCP service account JSON key file.
# The service account must have the Storage Object Admin role (or equivalent).
# Example: ./secrets/gcp-service-account.json
GOOGLE_CLOUD_CREDENTIALS_FILE=


# -----------------------------------------------------------------------------
# DOCKER COMPOSE
# Compose uses DB_PASSWORD above as the PostgreSQL password; there is no
# separate DB_ROOT_PASSWORD setting.
# -----------------------------------------------------------------------------
